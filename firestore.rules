rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 내 지갑: 본인만 읽을 수 있다. 만들기와 포인트 증감은 모두 서버(Cloud Functions, 관리자 권한)만 한다.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
